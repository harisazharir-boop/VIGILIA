# ============================================================
# VIGILIA — environment template
# Copy to `.env` and fill in. NEVER commit the real .env.
# ============================================================

# ---------- Backend ----------
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=debug

# Database (SQLite for local dev — file is created automatically)
DATABASE_URL="file:backend/prisma/dev.db"

# Server secret used to sign device tokens (CHANGE IN PRODUCTION)
# Generate with: openssl rand -hex 32
VIGILIA_SERVER_SECRET=change-me-to-a-long-random-hex-string

# Access token lifetime for agents
VIGILIA_AGENT_TOKEN_TTL_DAYS=365

# CORS origins allowed to call the API (comma separated)
VIGILIA_CORS_ORIGIN=http://127.0.0.1:3000,http://localhost:3000

# ---------- Mobile app (public, safe to expose) ----------
# URL the mobile web app uses to reach the backend API + WebSocket
VITE_VIGILIA_API_URL=http://127.0.0.1:3000
VITE_VIGILIA_WS_URL=ws://127.0.0.1:3000/ws

# ---------- Ubuntu agent ----------
VIGILIA_AGENT_NAME=Haris's Laptop
VIGILIA_BACKEND_URL=http://127.0.0.1:3000
# Agent token: leave EMPTY on first run — the agent registers and stores the
# issued token in the file below. Never hardcode it in source.
VIGILIA_AGENT_TOKEN=
# Path where the backend-issued token is persisted (400 perms)
VIGILIA_AGENT_TOKEN_FILE=.agent-token

# Telemetry cadence (seconds)
VIGILIA_TELEMETRY_INTERVAL=5
VIGILIA_HEARTBEAT_INTERVAL=10

# ---------- Local AI Guardian (Qwen2.5-3B-Instruct) ----------
# llama.cpp `llama-server` is default. No API key or cloud dependency.
VIGILIA_LOCAL_AI_URL=http://127.0.0.1:8080/v1
VIGILIA_LOCAL_AI_MODEL=Qwen2.5-3B-Instruct
VIGILIA_LOCAL_AI_MODEL_PATH=/opt/vigilia/models/Qwen2.5-3B-Instruct-Q4_K_M.gguf
VIGILIA_LOCAL_AI_MODEL_SHA256=
VIGILIA_LOCAL_AI_TIMEOUT_MS=8000
VIGILIA_LOCAL_AI_HEALTH_TIMEOUT_MS=1500
# Read-only diagnostics always run. Cleanup still needs existing daily policy.
VIGILIA_AI_AUTO_CLEANUP=0

# ---------- Database Retention (Phase 11F) ----------
VIGILIA_RETENTION_DAYS=90
VIGILIA_RETENTION_BATCH_SIZE=100
VIGILIA_RETENTION_INTERVAL_MS=21600000
