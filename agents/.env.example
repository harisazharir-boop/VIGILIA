# VIGILIA Agent configuration
# Copy to `.env` and fill in. NEVER commit the real file.
#
# Leave VIGILIA_AGENT_TOKEN empty on first run: the agent registers itself and
# stores the backend-issued token in VIGILIA_AGENT_TOKEN_FILE (mode 0400).

VIGILIA_AGENT_NAME=Haris's Laptop
VIGILIA_BACKEND_URL=http://127.0.0.1:3000
VIGILIA_AGENT_TOKEN=
VIGILIA_AGENT_TOKEN_FILE=.agent-token

# Seconds between telemetry samples / heartbeats
VIGILIA_TELEMETRY_INTERVAL=5
VIGILIA_HEARTBEAT_INTERVAL=10

# Suppress non-error console output (1 = quiet)
VIGILIA_AGENT_QUIET=0
